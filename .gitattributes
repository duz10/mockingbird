# Cross-platform line-ending policy.
#
# Rust + TS source files use LF on disk, regardless of OS. This keeps
# `cargo fmt` happy on Windows where git's default autocrlf would
# otherwise convert LF -> CRLF on checkout and rustfmt would complain.
#
# Markdown, JSON, TOML follow the same LF convention for consistency.
# .ps1 files stay native (CRLF on Windows) because PowerShell.

*           text=auto eol=lf

# Source / config files: force LF.
*.rs        text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
*.css       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf

# PowerShell stays native (Windows-only).
*.ps1       text eol=crlf

# Binary assets — never normalize.
*.png       binary
*.ico       binary
*.icns      binary
*.pfx       binary
*.pem       binary
*.key       binary
