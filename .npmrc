# SECURITY BASELINE: install scripts disabled repo-wide.
#
# Rationale: PLAN.md Appendix D + ADR 0006. Post-Shai-Hulud (Sept 2025)
# and Mini Shai-Hulud (May 2026), arbitrary code execution at install
# time is the dominant npm attack vector.
#
# The `block-unsafe-npm` hook ALSO enforces --ignore-scripts on every
# npm/pnpm/yarn install command, but defense in depth: this file is the
# belt to that hook's braces.
#
# If you have a legitimate need for a postinstall script (build native
# bindings, etc.) audit the package, vendor the build, and document
# in an ADR.

ignore-scripts=true
fund=false
audit=true
save-exact=true
