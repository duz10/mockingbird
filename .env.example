# Mockingbird environment variables — copy to .env (gitignored) when set.
#
# Phase 0: no env vars are required.
# Phase 4: ANTHROPIC_API_KEY for cloud cleanup (BYO; never shipped).
# Phase 7: TAURI_SIGNING_PRIVATE_KEY_PATH for release signing.

# ANTHROPIC_API_KEY=sk-ant-...
# TAURI_SIGNING_PRIVATE_KEY_PATH=%USERPROFILE%\.tauri\mockingbird.key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
